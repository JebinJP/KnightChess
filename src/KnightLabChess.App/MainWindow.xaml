<Window x:Class="KnightLabChess.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
        xmlns:views="clr-namespace:KnightLabChess.App.Views"
        Title="{Binding WindowTitle}"
        Icon="Assets/app.ico"
        Height="850" Width="1360"
        MinHeight="640" MinWidth="960"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Map ViewModels to Views via DataTemplates -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayViewModel}">
            <views:PlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiCoachViewModel}">
            <views:AiCoachView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearnViewModel}">
            <views:LearnView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PuzzlesViewModel}">
            <views:PuzzlesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
            <views:AnalysisView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpeningExplorerViewModel}">
            <views:OpeningExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
            <views:ProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Logo/Title -->
                <Border DockPanel.Dock="Top" Padding="16,20,16,16">
                    <StackPanel>
                        <TextBlock Text="♞" FontSize="36" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="KnightLab" 
                                   Style="{StaticResource H2TextStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Chess Academy" 
                                   Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0">
                            <TextBlock Text="v2.0 Release"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentLightBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="{StaticResource BorderBrush}" Margin="16,0" />

                <!-- Navigation Items -->
                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding NavigationItems}"
                              Margin="8,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButtonStyle}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Width="28" 
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom spacer -->
                <Border />
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundDarkBrush}">
            <ContentPresenter Content="{Binding CurrentPage}" />
        </Border>
    </Grid>
</Window>
