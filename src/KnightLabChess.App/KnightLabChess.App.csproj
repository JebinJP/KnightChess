<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KnightLabChess.Core\KnightLabChess.Core.csproj" />
    <ProjectReference Include="..\KnightLabChess.Infrastructure\KnightLabChess.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Content Include="..\..\content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Link>content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KnightLabChess</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>KnightLab Chess</Product>
    <Title>KnightLab Chess</Title>
    <Version>1.0.0</Version>
    <Company>KnightLab</Company>
    <Authors>KnightLab</Authors>
    <Description>Master chess with tactical puzzles, deep Stockfish engine analysis, opening repertoires, and interactive academy lessons.</Description>
  </PropertyGroup>

</Project>
