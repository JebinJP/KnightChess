<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  KnightLab Chess V2.0 — Refined Obsidian Glass & Gold System -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Neutral Layered Backgrounds (Obsidian to Charcoal) -->
    <Color x:Key="BackgroundDarkestColor">#FF0C0D10</Color>
    <Color x:Key="BackgroundDarkColor">#FF12141A</Color>
    <Color x:Key="BackgroundColor">#FF171A22</Color>
    <Color x:Key="BackgroundLightColor">#FF1E222D</Color>
    <Color x:Key="BackgroundLighterColor">#FF272C39</Color>

    <!-- Glass & Card Surfaces (Layered translucent charcoal) -->
    <Color x:Key="SurfaceColor">#FF1C202A</Color>
    <Color x:Key="SurfaceLightColor">#FF252B38</Color>
    <Color x:Key="SurfaceHoverColor">#FF2E3646</Color>
    <Color x:Key="SurfaceGlassColor">#D91C202A</Color>
    <Color x:Key="SurfaceGlassLightColor">#E6252B38</Color>

    <!-- Subtle Glass & Structural Borders -->
    <Color x:Key="BorderColor">#FF282D3A</Color>
    <Color x:Key="BorderLightColor">#FF383F52</Color>
    <Color x:Key="GlassBorderColor">#20FFFFFF</Color>
    <Color x:Key="GlassBorderLightColor">#38FFFFFF</Color>

    <!-- Refined Typography System -->
    <Color x:Key="TextPrimaryColor">#FFF4F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FF9CA3AF</Color>
    <Color x:Key="TextMutedColor">#FF64748B</Color>
    <Color x:Key="TextDisabledColor">#FF475569</Color>

    <!-- Single Restrained Accent: Tournament Warm Amber / Burnished Gold -->
    <Color x:Key="AccentColor">#FFC89B3C</Color>
    <Color x:Key="AccentLightColor">#FFDCB054</Color>
    <Color x:Key="AccentDarkColor">#FFA47C25</Color>
    <Color x:Key="AccentSubtleColor">#20C89B3C</Color>
    <Color x:Key="AccentHoverGlowColor">#40C89B3C</Color>

    <!-- Semantic State Colors (Clear and functional) -->
    <Color x:Key="SuccessColor">#FF22C55E</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>
    <Color x:Key="ErrorColor">#FFEF4444</Color>
    <Color x:Key="InfoColor">#FF3B82F6</Color>

    <!-- Classic High-Contrast Tournament Chessboard Palette -->
    <Color x:Key="BoardLightSquareColor">#FFEEEED2</Color>
    <Color x:Key="BoardDarkSquareColor">#FF769656</Color>
    <Color x:Key="BoardSelectedSquareColor">#B3F7E043</Color>
    <Color x:Key="BoardLegalMoveColor">#40000000</Color>
    <Color x:Key="BoardLastMoveColor">#80F7E043</Color>
    <Color x:Key="BoardCheckColor">#B3E53935</Color>

    <!-- Solid & Glass Brushes -->
    <SolidColorBrush x:Key="BackgroundDarkestBrush" Color="{StaticResource BackgroundDarkestColor}" />
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}" />
    <SolidColorBrush x:Key="BackgroundLighterBrush" Color="{StaticResource BackgroundLighterColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="{StaticResource SurfaceGlassColor}" />
    <SolidColorBrush x:Key="SurfaceGlassLightBrush" Color="{StaticResource SurfaceGlassLightColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />
    <SolidColorBrush x:Key="GlassBorderLightBrush" Color="{StaticResource GlassBorderLightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="AccentHoverGlowBrush" Color="{StaticResource AccentHoverGlowColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="BoardLightSquareBrush" Color="{StaticResource BoardLightSquareColor}" />
    <SolidColorBrush x:Key="BoardDarkSquareBrush" Color="{StaticResource BoardDarkSquareColor}" />
    <SolidColorBrush x:Key="BoardSelectedSquareBrush" Color="{StaticResource BoardSelectedSquareColor}" />
    <SolidColorBrush x:Key="BoardLegalMoveBrush" Color="{StaticResource BoardLegalMoveColor}" />
    <SolidColorBrush x:Key="BoardLastMoveBrush" Color="{StaticResource BoardLastMoveColor}" />
    <SolidColorBrush x:Key="BoardCheckBrush" Color="{StaticResource BoardCheckColor}" />

</ResourceDictionary>
