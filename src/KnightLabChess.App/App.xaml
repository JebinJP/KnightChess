<Application x:Class="KnightLabChess.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KnightLabChess.App"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/ChessPieces.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:SquareBackgroundConverter x:Key="SquareBackgroundConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:FeedbackColorConverter x:Key="FeedbackColorConverter" />
            <converters:GeometryKeyConverter x:Key="GeometryKeyConverter" />
            <converters:DrawingKeyConverter x:Key="DrawingKeyConverter" />
            <converters:BoardCoordinateBrushConverter x:Key="BoardCoordinateBrushConverter" />
            <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
