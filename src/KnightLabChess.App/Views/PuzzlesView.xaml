<UserControl x:Class="KnightLabChess.App.Views.PuzzlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:FeedbackColorConverter x:Key="FeedbackColorConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Interactive Puzzle Board Arena -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Puzzle Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,12"
                    Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PuzzleTitle}"
                                   Style="{StaticResource H2TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <!-- Theme Badge -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPuzzle.Theme}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>

                        <!-- Rating Badge -->
                        <Border Background="{StaticResource SurfaceHoverBrush}"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Rating, StringFormat='{}{0} Rating'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Turn indicator -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Board.StatusText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Board Center Container -->
            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundDarkBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Viewbox MaxHeight="540" MaxWidth="540" Stretch="Uniform">
                    <controls:ChessBoardControl DataContext="{Binding Board}" />
                </Viewbox>
            </Border>
        </Grid>

        <!-- Right Column: Puzzle Controls & Tactics Panel -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22">
            <DockPanel>
                <!-- Header Stats: Streak & Solved Count -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource BackgroundDarkBrush}"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Streak -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔥" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="STREAK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SolvedStreak}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Total Solved -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🏆" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SOLVED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding TotalPuzzlesSolved}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Action Buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="↻ Retry"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RetryPuzzleCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Next Puzzle →"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoadNextPuzzleCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>

                <!-- Middle Scrollable Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Objective / Description -->
                        <TextBlock Text="TACTICAL OBJECTIVE"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PuzzleDescription}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Margin="0,0,0,18" />

                        <!-- Difficulty Filter -->
                        <TextBlock Text="DIFFICULTY LEVEL"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Difficulties}"
                                  SelectedItem="{Binding SelectedDifficulty}"
                                  Padding="10,6"
                                  Margin="0,0,0,18"
                                  Background="{StaticResource BackgroundDarkBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" />

                        <!-- Feedback Banner -->
                        <Border BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,0,0,16"
                                Visibility="{Binding FeedbackText, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#161A20" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <Binding Path="IsPuzzleSolved" Converter="{StaticResource FeedbackColorConv}" />
                            </Border.BorderBrush>
                            <TextBlock Text="{Binding FeedbackText}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Hint Box -->
                        <StackPanel Margin="0,0,0,16">
                            <Button Content="💡 Need a Hint?"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ShowHintActionCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,8" />
                            <Border Background="{StaticResource SurfaceHoverBrush}"
                                    BorderBrush="{StaticResource AccentDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding HintText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Post-Solve Explanation Box -->
                        <Border Background="{StaticResource SurfaceHoverBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,16"
                                Visibility="{Binding ShowExplanation, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Solution Analysis"
                                           Style="{StaticResource H3TextStyle}"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding ExplanationText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
