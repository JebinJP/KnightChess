<UserControl x:Class="KnightLabChess.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,14"
                    Margin="0,0,0,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Academy Journey &amp; Progress"
                                       Style="{StaticResource H2TextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Monitor your lesson completion, puzzle accuracy, game results, and milestone badges."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="⟳ Refresh"
                            Command="{Binding RefreshStatsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,6"
                            VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Top Row: 4 Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lessons Card -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACADEMY CURRICULUM"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding LessonsCompleted}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding TotalLessonsCount, StringFormat='/ {0}'}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,4" />
                        </DockPanel>
                        <ProgressBar Value="{Binding LessonCompletionPercent}"
                                     Maximum="100"
                                     Height="6"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#1E232A"
                                     Margin="0,0,0,6" />
                        <TextBlock Text="{Binding LessonCompletionPercent, StringFormat='{}{0}% Completed'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Puzzles Card -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="PUZZLES SOLVED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding PuzzlesSolved}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PuzzleAccuracy, StringFormat='{}{0}% Accuracy'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentStreak, StringFormat='🔥 {0} Streak'}"
                                       FontSize="11"
                                       Foreground="#F59E0B"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Games Record Card -->
                <Border Grid.Column="4"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="GAMES RECORD"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding GamesPlayed}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding WinRatePercent, StringFormat='({0}% Win Rate)'}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,4" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GamesWon, StringFormat='{}{0}W'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding GamesLost, StringFormat='{}{0}L'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding GamesDrawn, StringFormat='{}{0}D'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Streak Card -->
                <Border Grid.Column="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="LONGEST STREAK"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding LongestStreak}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#F59E0B"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="Puzzles"
                                       FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,4" />
                        </DockPanel>
                        <TextBlock Text="Calculated with zero mistakes"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Curricula Breakdown & Achievements (Left) + Recent Games (Right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Stages & Milestone Badges -->
                <StackPanel Grid.Column="0">
                    <!-- Stage Progress -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Curriculum Stages Breakdown"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,16" />

                            <!-- Stage 1 Beginner -->
                            <Border Background="#161A20" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Stage 1: Beginner Fundamentals"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding BeginnerCompleted, StringFormat='{}{0}/9 Completed'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding BeginnerCompleted}"
                                                 Maximum="{Binding BeginnerTotal}"
                                                 Height="6"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#252A30" />
                                </StackPanel>
                            </Border>

                            <!-- Stage 2 Fundamentals -->
                            <Border Background="#161A20" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Stage 2: Strategy &amp; Principles"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding FundamentalsCompleted, StringFormat='{}{0}/3 Completed'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding FundamentalsCompleted}"
                                                 Maximum="{Binding FundamentalsTotal}"
                                                 Height="6"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#252A30" />
                                </StackPanel>
                            </Border>

                            <!-- Stage 3 Tactics -->
                            <Border Background="#161A20" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Stage 3: Tactical Combinations"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding IntermediateCompleted, StringFormat='{}{0}/6 Completed'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding IntermediateCompleted}"
                                                 Maximum="{Binding IntermediateTotal}"
                                                 Height="6"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#252A30" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Achievements & Milestone Badges -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Milestone Achievements"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding Achievements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161A20"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="4">
                                            <DockPanel>
                                                <!-- Icon badge -->
                                                <Border DockPanel.Dock="Left"
                                                        Width="40" Height="40"
                                                        CornerRadius="20"
                                                        Background="#2010B981"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontSize="20"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel VerticalAlignment="Center">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding ProgressText}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Recent Games History -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="Recent Match History"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding RecentGames.Count, StringFormat='{}{0} Games'}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Games List -->
                        <ItemsControl ItemsSource="{Binding RecentGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161A20"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <DockPanel>
                                            <!-- Result Tag -->
                                            <Border DockPanel.Dock="Right"
                                                    Background="#252A30"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Result}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="⚪ " FontSize="11" />
                                                    <TextBlock Text="{Binding WhitePlayer}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text=" vs " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="⚫ " FontSize="11" />
                                                    <TextBlock Text="{Binding BlackPlayer}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding MoveCount, StringFormat='{}{0} moves | '}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding EndReason, StringFormat='by {0} | '}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM dd}'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State if no games played yet -->
                        <Border Visibility="{Binding RecentGames.Count, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                Margin="0,10,0,0">
                            <TextBlock Text="Play games vs Computer or in Two-Player mode to record match history."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
