<UserControl x:Class="KnightLabChess.App.Views.OpeningExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Interactive Chess Board and Move Breadcrumbs -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Controls -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📚" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Opening Explorer"
                                   Style="{StaticResource H2TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Border Background="#2010B981"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="Interactive Repertoire"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟲ Reset"
                                Command="{Binding ResetPositionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,8,0" />
                        <Button Content="↶ Undo"
                                Command="{Binding UndoMoveCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,8,0" />
                        <Button Content="⇅ Flip"
                                Command="{Binding FlipBoardCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Chess Board -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Viewbox MaxHeight="540" MaxWidth="540" Stretch="Uniform">
                    <controls:ChessBoardControl DataContext="{Binding Board}" />
                </Viewbox>
            </Border>

            <!-- Move History Breadcrumb Ribbon -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="Moves Played:"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MoveHistorySan}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252A30"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Column: Repertoire Details, Candidate Continuations, & Opening Browser -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Active Opening Card -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- ECO & Name -->
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding CurrentOpening.Eco, FallbackValue='ECO'}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#000000" />
                            </Border>

                            <TextBlock Text="{Binding CurrentOpening.Name, FallbackValue='Custom / Initial Position'}"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Variation Subtitle -->
                        <TextBlock Text="{Binding CurrentOpening.Variation}"
                                   FontSize="13"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding CurrentOpening.Variation, Converter={StaticResource BoolToVis}}" />

                        <!-- Master Win Rate Bar -->
                        <Grid Margin="0,4,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="Master Game Win Rates:"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding CurrentOpening.MasterGamesCount, StringFormat='{}{0:N0} Games', FallbackValue='N/A'}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <!-- Color-coded percentage strip -->
                            <Border Grid.Row="1" Height="10" CornerRadius="5" Background="#1E232A" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CurrentOpening.WhiteWinPercent, FallbackValue=38, Mode=OneWay, StringFormat='{}{0}*'}" />
                                        <ColumnDefinition Width="{Binding CurrentOpening.DrawPercent, FallbackValue=40, Mode=OneWay, StringFormat='{}{0}*'}" />
                                        <ColumnDefinition Width="{Binding CurrentOpening.BlackWinPercent, FallbackValue=22, Mode=OneWay, StringFormat='{}{0}*'}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#10B981" ToolTip="White Wins" />
                                    <Border Grid.Column="1" Background="#6B7280" ToolTip="Draws" />
                                    <Border Grid.Column="2" Background="#EF4444" ToolTip="Black Wins" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Win Percent Legends -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <TextBlock Text="{Binding CurrentOpening.WhiteWinPercent, StringFormat='⚪ White {0}%', FallbackValue='⚪ 38%'}"
                                       FontSize="11" Foreground="#10B981" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding CurrentOpening.DrawPercent, StringFormat='Draw {0}%', FallbackValue='Draw 40%'}"
                                       FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentOpening.BlackWinPercent, StringFormat='⚫ Black {0}%', FallbackValue='⚫ 22%'}"
                                       FontSize="11" Foreground="#F87171" HorizontalAlignment="Right" />
                        </UniformGrid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                        <!-- Strategic Description -->
                        <TextBlock Text="{Binding CurrentOpening.Description, FallbackValue='Play moves on the board or select an opening below to explore grandmaster master lines and win rates.'}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />

                        <!-- Key Ideas -->
                        <TextBlock Text="Key Strategic Ideas:"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,4,0,2"
                                   Visibility="{Binding CurrentOpening.KeyIdeas, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding CurrentOpening.KeyIdeas}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding CurrentOpening.KeyIdeas, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Candidate Continuations Tree -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Candidate Continuations"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding CandidateMoves.Count, StringFormat='{}{0} Options'}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding CandidateMoves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1E24"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <!-- Move Play Button -->
                                            <Button DockPanel.Dock="Right"
                                                    Content="Play ▶"
                                                    Command="{Binding DataContext.PlayCandidateMoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    VerticalAlignment="Center" />

                                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding UciMove}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding ContinuationName}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="190" />
                                                </StackPanel>

                                                <!-- Stat Line -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GamesCount, StringFormat='{}{0:N0} gms | '}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding WhiteWinPercent, StringFormat='⚪{0}% '}"
                                                               FontSize="11"
                                                               Foreground="#10B981" />
                                                    <TextBlock Text="{Binding DrawPercent, StringFormat='={0}% '}"
                                                               FontSize="11"
                                                               Foreground="#9CA3AF" />
                                                    <TextBlock Text="{Binding BlackWinPercent, StringFormat='⚫{0}%'}"
                                                               FontSize="11"
                                                               Foreground="#F87171" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Repertoire Database Browser -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Master Repertoire Index"
                                   Style="{StaticResource H2TextStyle}"
                                   FontSize="15"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10" />

                        <!-- Search Bar -->
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,10"
                                 Padding="10,6"
                                 ToolTip="Search openings by name or ECO code..." />

                        <!-- Color Filter Pills -->
                        <ItemsControl ItemsSource="{Binding ColorFilterOptions}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding}"
                                                 GroupName="ExplorerColorFilter"
                                                 Margin="0,0,8,0"
                                                 Padding="12,5"
                                                 FontSize="11"
                                                 Style="{StaticResource TabRadioButtonStyle}"
                                                 IsChecked="{Binding DataContext.SelectedColorFilter, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Null}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Opening List Items -->
                        <ItemsControl ItemsSource="{Binding Openings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161A20"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Study"
                                                    Command="{Binding DataContext.SelectOpeningCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    VerticalAlignment="Center" />

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Background="#252A30"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Eco}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FullName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="220" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding MovesSan}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="260" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
