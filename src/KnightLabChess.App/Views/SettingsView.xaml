<UserControl x:Class="KnightLabChess.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Action Controls -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,14"
                    Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Settings &amp; Engine Preferences"
                                       Style="{StaticResource H2TextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Configure UCI Stockfish paths, board styling, audio effects, and database storage."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Reset Defaults"
                                Command="{Binding ResetToDefaultsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,6"
                                Margin="0,0,10,0" />

                        <Button Content="Save Settings"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,6" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Feedback Message Banner -->
            <Border Grid.Row="1"
                    Background="#1E2B24"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding FeedbackMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FeedbackMessage}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- Main Content: Two Columns -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Engine Settings -->
                <StackPanel Grid.Column="0">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="Stockfish UCI Engine"
                                           Style="{StaticResource H2TextStyle}"
                                           FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           DockPanel.Dock="Left" />

                                <Border Background="#161A20"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding EngineStatusText}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <!-- Stockfish Path Browser -->
                            <TextBlock Text="Stockfish Executable Path:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding StockfishPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Padding="10,6"
                                         ToolTip="Absolute path to stockfish.exe" />

                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        Command="{Binding BrowseStockfishCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" />

                                <Button Grid.Column="4"
                                        Content="Test"
                                        Command="{Binding TestEngineCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" />
                            </Grid>

                            <TextBlock Text="Leave blank to use the built-in tactical heuristic engine for zero-setup offline play."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,16" />

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                            <!-- Engine Depth Slider -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Default Search Depth:"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding EngineDepth, StringFormat='{}Depth {0}'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Slider Value="{Binding EngineDepth}"
                                    Minimum="5"
                                    Maximum="25"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16" />

                            <!-- Engine Threads Slider -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="CPU Threads:"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding EngineThreads, StringFormat='{}{0} Threads'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Slider Value="{Binding EngineThreads}"
                                    Minimum="1"
                                    Maximum="8"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16" />

                            <!-- Hash Size Slider -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Memory Hash Table:"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding EngineHashMb, StringFormat='{}{0} MB'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Slider Value="{Binding EngineHashMb}"
                                    Minimum="16"
                                    Maximum="512"
                                    TickFrequency="16"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,16" />

                            <!-- Checkbox fallback -->
                            <CheckBox IsChecked="{Binding UseFallbackIfNotFound}"
                                      Content="Enable pure offline tactical heuristic fallback when Stockfish is absent"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Board Visuals, Audio & Storage -->
                <StackPanel Grid.Column="2">
                    <!-- Board & Visuals Card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Board Appearance &amp; Audio"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Color Theme:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />

                            <!-- Board Theme Pills -->
                            <ItemsControl ItemsSource="{Binding BoardThemeOptions}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding}"
                                                     GroupName="SettingsBoardTheme"
                                                     Margin="0,0,8,0"
                                                     Padding="14,6"
                                                     FontSize="12"
                                                     Style="{StaticResource TabRadioButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Checkboxes -->
                            <CheckBox IsChecked="{Binding HighlightLegalMoves}"
                                      Content="Highlight legal destination squares and capture rings"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,0,10" />

                            <CheckBox IsChecked="{Binding ShowMoveAnimations}"
                                      Content="Smooth move transitions and piece animations"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,0,16" />

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                            <!-- Audio -->
                            <CheckBox IsChecked="{Binding SoundEnabled}"
                                      Content="Play sound effects for moves, captures, and checks"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,0,10" />

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Sound Volume:"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding SoundVolume, StringFormat='{}{0}%'}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <Slider Value="{Binding SoundVolume}"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True" />
                        </StackPanel>
                    </Border>

                    <!-- Storage & System Info Card -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="System &amp; Storage"
                                       Style="{StaticResource H2TextStyle}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Database Path:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />

                            <Border Background="#161A20"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,12">
                                <TextBlock Text="{Binding DatabasePath}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>

                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Version:"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding AppVersion, StringFormat='KnightLab Chess v{0}'}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
