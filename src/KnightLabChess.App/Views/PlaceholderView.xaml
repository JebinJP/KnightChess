<UserControl x:Class="KnightLabChess.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="40,32"
                MaxWidth="500">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding PageIcon}"
                           FontSize="48"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource H2TextStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="This section is scheduled for a future milestone."
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBlock Text="Milestone 1 focuses strictly on the Core Vertical Slice: complete chess rules, interactive board, checkmate/draw detection, and SQLite persistence."
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
