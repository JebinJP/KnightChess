<UserControl x:Class="KnightLabChess.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Evaluation Bar + Chess Board Arena -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status & Engine Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,12"
                    Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Deep Engine Analysis"
                                   Style="{StaticResource H2TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Border Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding EngineStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ToggleAnalysisCommand}"
                            Padding="14,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Content" Value="❚❚ Pause Engine" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="False">
                                        <Setter Property="Content" Value="▶ Resume Engine" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Board & Evaluation Bar Row: Maximized and Responsive -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- LIVE VERTICAL EVALUATION BAR               -->
                <!-- ========================================== -->
                <Border Grid.Column="0"
                        Width="26"
                        VerticalAlignment="Stretch"
                        Background="#FF1E1E1E"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,8,16,8"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Top Black Area -->
                        <Border Background="#FF1E1E1E" VerticalAlignment="Stretch" />

                        <!-- Bottom White Area (Height adjusted dynamically via Advantage Percentage) -->
                        <ProgressBar Value="{Binding WhiteAdvantagePercentage}"
                                     Minimum="0" Maximum="100"
                                     Orientation="Vertical"
                                     Foreground="#FFF5F5F5"
                                     Background="#FF1E1E1E"
                                     BorderThickness="0" />

                        <!-- Advantage Score Badge Overlay -->
                        <Border Background="#D8121417"
                                CornerRadius="4"
                                Padding="4,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding EvaluationScoreText}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Board -->
                <controls:ChessBoardControl Grid.Column="1" DataContext="{Binding Board}" />
            </Grid>
        </Grid>

        <!-- Right Column: Engine Metrics, PV Line, and Position Controls -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Real-Time Metrics Card -->
                    <Border Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="STOCKFISH EVALUATION"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6" />

                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding EvaluationScoreText}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding EvalDepth, StringFormat='Depth: {0}'}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="UCI Protocol"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Best Move Suggestion -->
                            <Border Background="{StaticResource SurfaceHoverBrush}"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Play Move →"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PlayBestMoveCommand}"
                                            Padding="10,4"
                                            FontSize="11" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RECOMMENDED MOVE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding BestMoveUci}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Principal Variation (PV line) -->
                            <TextBlock Text="PRINCIPAL VARIATION"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="{Binding PrincipalVariationText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- AI Coach Card -->
                    <Border Background="{StaticResource SurfaceGlassBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding AskCoachButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AskCoachCommand}"
                                        Padding="12,5"
                                        FontSize="11" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="AI Position Coach"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="{Binding CoachExplanation}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Position Controls -->
                    <TextBlock Text="BOARD ACTIONS"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8" />

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Flip Board"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding FlipBoardCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Undo Move"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UndoMoveAsyncCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <Button Content="Reset Starting Position"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetToStartingPositionAsyncCommand}"
                            Margin="0,0,0,20" />

                    <!-- FEN Loader Card -->
                    <Border Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="LOAD FEN POSITION"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6" />

                            <TextBox Text="{Binding CustomFenInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     FontSize="11"
                                     Margin="0,0,0,10" />

                            <Button Content="Load FEN Position"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadCustomFenAsyncCommand}"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
