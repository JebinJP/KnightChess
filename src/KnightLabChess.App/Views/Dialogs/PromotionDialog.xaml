<Window x:Class="KnightLabChess.App.Views.Dialogs.PromotionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Promotion Piece"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Border Background="{StaticResource SurfaceGlassBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="20"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="DialogScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0"
                                         Duration="0:0:0.14" />
                        <DoubleAnimation Storyboard.TargetName="DialogScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.94" To="1.0"
                                         Duration="0:0:0.14">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="DialogScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.94" To="1.0"
                                         Duration="0:0:0.14">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="8" Color="#000000" Opacity="0.75" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar with Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Promote Pawn"
                           Style="{StaticResource H2TextStyle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Cancel_Click"
                        Width="28" Height="28"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Cancel (Esc)">
                    <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Piece Options -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,5">
                <!-- Queen -->
                <Button Margin="6"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Queen_Click"
                        ToolTip="Promote to Queen">
                    <TextBlock x:Name="QueenGlyph" Text="♛" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Rook -->
                <Button Margin="6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Rook_Click"
                        ToolTip="Promote to Rook">
                    <TextBlock x:Name="RookGlyph" Text="♜" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Bishop -->
                <Button Margin="6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Bishop_Click"
                        ToolTip="Promote to Bishop">
                    <TextBlock x:Name="BishopGlyph" Text="♝" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Knight -->
                <Button Margin="6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Knight_Click"
                        ToolTip="Promote to Knight">
                    <TextBlock x:Name="KnightGlyph" Text="♞" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
