<UserControl x:Class="KnightLabChess.App.Views.LearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:lessons="clr-namespace:KnightLabChess.Core.Lessons;assembly=KnightLabChess.Core"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:PercentageConverter x:Key="PercentageConv" />
        <converters:FeedbackColorConverter x:Key="FeedbackColorConv" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConv" />
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- ========================================================= -->
        <!-- VIEW 1: CURRICULUM BROWSER (Visible when !IsLessonActive) -->
        <!-- ========================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLessonActive}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
                <!-- Header Banner -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="28"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="KnightLab Academy"
                                       Style="{StaticResource H1TextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="Structured, interactive lessons designed to teach pattern recognition, tactical calculation, and strategic thinking."
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />
                            <TextBlock Text="Select a stage below to browse lessons with interactive exercises."
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="📖"
                                   FontSize="64"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,10,0" />
                    </Grid>
                </Border>

                <!-- Stage Selection Pills -->
                <ItemsControl ItemsSource="{Binding Stages}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                         Margin="0,0,10,0"
                                         Padding="16,8"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="{StaticResource SurfaceBrush}"
                                         GroupName="StageSelector"
                                         Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="20"
                                                            Padding="{TemplateBinding Padding}"
                                                            Cursor="Hand">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Lessons List -->
                <ItemsControl ItemsSource="{Binding Lessons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LessonListItem}">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Lesson Information -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{StaticResource BackgroundDarkBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource SurfaceHoverBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StepCount, StringFormat='{}{0} Steps'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <!-- Completed Badge -->
                                            <Border Background="#1A10B981"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MasteryScore, StringFormat='✓ Completed ({0:F0}%)'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource H2TextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Start / Resume Button -->
                                    <Button Grid.Column="1"
                                            Content="Start Lesson →"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.StartLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"
                                            Padding="22,12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- VIEW 2: ACTIVE LESSON PLAYER (Visible when IsLessonActive) -->
        <!-- ========================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLessonActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Left: Interactive Board Arena -->
            <Grid Grid.Column="0" Margin="0,0,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Back Bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,10"
                        Margin="0,0,0,16">
                    <DockPanel>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="← Exit Lesson"
                                Command="{Binding ExitLessonCommand}"
                                Padding="12,6" />
                        <TextBlock Text="{Binding CurrentLessonTitle}"
                                   Style="{StaticResource H3TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>

                <!-- Chess Board -->
                <Border Grid.Row="1"
                        Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <controls:ChessBoardControl DataContext="{Binding LessonBoard}" />
                </Border>
            </Grid>

            <!-- Right: Interactive Lesson Step Panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24">
                <DockPanel>
                    <!-- Header: Step Counter & Progress Bar -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding StepTitle}"
                                       Style="{StaticResource H2TextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock DockPanel.Dock="Right"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Step {0} of {1}">
                                        <Binding Path="CurrentStepIndex" ConverterParameter="1" />
                                        <Binding Path="TotalSteps" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>

                        <!-- Progress Bar -->
                        <ProgressBar Value="{Binding ProgressPercentage}"
                                     Height="6"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SurfaceHoverBrush}"
                                     BorderThickness="0" />
                    </StackPanel>

                    <!-- Bottom Navigation Buttons -->
                    <Border DockPanel.Dock="Bottom" Padding="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="← Previous"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PreviousStepCommand}"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Next →"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NextStepCommand}"
                                    IsEnabled="{Binding CanAdvance}"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Scrollable Step Content Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Step Explanation Text -->
                            <TextBlock Text="{Binding StepText}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="22"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20" />

                            <!-- Demonstration Playback Card -->
                            <Border Background="{StaticResource SurfaceHoverBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding IsDemonstrationStep, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="▶ Play Moves"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PlayDemonstrationCommand}"
                                            Padding="16,8"
                                            VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Move Sequence"
                                                   Style="{StaticResource H3TextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,2" />
                                        <TextBlock Text="Watch the pieces move live on the board."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Interactive Quiz Options (when Step is Quiz) -->
                            <ItemsControl ItemsSource="{Binding QuizOptions}"
                                          Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lessons:QuizOption}">
                                        <Button Content="{Binding Text}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.AnswerQuizCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,0,0,10"
                                                Padding="14,12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Hint Box / Expander -->
                            <StackPanel Margin="0,0,0,20">
                                <Button Content="💡 Need a Hint?"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowHintActionCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,6"
                                        Margin="0,0,0,8" />
                                <Border Background="{StaticResource SurfaceHoverBrush}"
                                        BorderBrush="{StaticResource AccentDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Visibility="{Binding ShowHint, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding HintText}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Feedback Banner (Correct / Incorrect) -->
                            <Border BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding ShowFeedback, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <SolidColorBrush Color="#182028" />
                                </Border.Background>
                                <Border.BorderBrush>
                                    <Binding Path="IsFeedbackCorrect" Converter="{StaticResource FeedbackColorConv}" />
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="18"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="❌" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFeedbackCorrect}" Value="True">
                                                        <Setter Property="Text" Value="✓" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FeedbackText}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
