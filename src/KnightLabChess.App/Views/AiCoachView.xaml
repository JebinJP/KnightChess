<UserControl x:Class="KnightLabChess.App.Views.AiCoachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:converters="clr-namespace:KnightLabChess.App.Converters"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EqualityToBooleanConverter x:Key="EqualityConverter" />

        <Style x:Key="CoachTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header & Settings Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Arena (Board on Left, Coach Modules on Right) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: TOP COACH HEADER                                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceGlassBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title, Tagline & Engine Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="26" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Gemini AI Chess Coach"
                                       Style="{StaticResource H2TextStyle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <Border Background="{StaticResource AccentSubtleBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding AiStatusBadge}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentLightBrush}" />
                            </Border>

                            <Border Background="#20FFFFFF"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding EngineEvalText, StringFormat='Stockfish: {0}'}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Authoritative engine calculations interpreted into pedagogical grandmaster insights."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Persona & Skill Level Pickers -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="SKILL LEVEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableSkillLevels}"
                                  SelectedItem="{Binding SelectedSkillLevel}"
                                  Width="120"
                                  Height="28"
                                  Background="{StaticResource BackgroundDarkBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource GlassBorderBrush}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="COACH PERSONA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding AvailablePersonas}"
                                  SelectedItem="{Binding SelectedPersona}"
                                  Width="160"
                                  Height="28"
                                  Background="{StaticResource BackgroundDarkBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource GlassBorderBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: MAIN ARENA                                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Interactive Chess Board -->
                <ColumnDefinition Width="*" />
                <!-- Right: Coach Workstation Panels -->
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Chess Board Arena & Controls -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Chess Board -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceGlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ChessBoardControl DataContext="{Binding Board}" />
                    </Grid>
                </Border>

                <!-- Bottom Board Controls Bar -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceGlassBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✦" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Flip Board"
                                    Command="{Binding FlipBoardCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    FontSize="11" />

                            <Button Content="Undo Move"
                                    Command="{Binding UndoMoveAsyncCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    FontSize="11" />

                            <Button Content="Reset Board"
                                    Command="{Binding ResetBoardAsyncCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,5"
                                    FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: Coach Modules Workstation -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Tab Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Tab Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TAB SELECTOR BAR -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,0,16">
                        <UniformGrid Columns="5">
                            <Button Content="Move"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="MoveAnalysis">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CoachTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="MoveAnalysis">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Threats"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="Threats">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CoachTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Threats">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Hints"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="Hints">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CoachTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="Hints">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Ask Q&amp;A"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="QandA">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CoachTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="QandA">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Review"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="GameReview">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CoachTabButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab}" Value="GameReview">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- ================================================ -->
                    <!-- TAB 1: MOVE BREAKDOWN                           -->
                    <!-- ================================================ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="MoveAnalysis">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Move Classification & Header Banner -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MoveClassificationBadge}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource AccentLightBrush}" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MoveExplanationTitle, FallbackValue='Move Breakdown'}"
                                                       Style="{StaticResource H3TextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding MoveScoreDelta, StringFormat='Centipawn Swing: {0}'}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Engine Verification Metrics -->
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Border Background="{StaticResource BackgroundDarkBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="EVAL BEFORE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding MoveScoreBefore}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BackgroundDarkBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="2,0,2,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="EVAL AFTER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding MoveScoreAfter}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BackgroundDarkBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="BEST ENGINE MOVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding MoveBestAlternative}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Pedagogical Explanation Cards -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TACTICAL ASSESSMENT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding MoveExplanationSummary}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding MoveExplanationTactics}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Strategic Advice Card -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="STRATEGIC GUIDANCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding MoveExplanationStrategy}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Key Threats Created / Overlooked -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="CRITICAL THREATS &amp; CONSEQUENCES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding MoveKeyThreats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2,0,4">
                                                        <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Action Button -->
                                <Button Content="✦ Explain Last Move"
                                        Command="{Binding ExplainLastMoveAsyncCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,10"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- TAB 2: THREAT RADAR                             -->
                    <!-- ================================================ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Threats">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Threat Summary Banner -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="OPPONENT THREAT RADAR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding ThreatSummary}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Direct Threats List -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DIRECT INCOMING THREATS" FontSize="9" FontWeight="Bold" Foreground="#FFFF7777" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DirectThreats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3,0,4">
                                                        <TextBlock Text="⚠" Foreground="#FFFF7777" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Defensive Remedies -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="DEFENSIVE REMEDIES &amp; CANDIDATE MOVES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DefensiveIdeas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3,0,4">
                                                        <TextBlock Text="🛡" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Button Content="Scan Opponent Threats"
                                        Command="{Binding ScanOpponentThreatsAsyncCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,10"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- TAB 3: PROGRESSIVE HINTS                        -->
                    <!-- ================================================ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Hints">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Hint Level Progress Badge -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HintLevelBadge}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentLightBrush}" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HintTitle}"
                                                       Style="{StaticResource H3TextStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Progressive coaching without spoiling answers"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Hint Content Card -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="PEDAGOGICAL CLUE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding HintDescription}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Border>

                                <!-- Ladder Explainer -->
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="HINT LADDER PROGRESSION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="• Level 1: Board area &amp; sector advantage" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                                        <TextBlock Text="• Level 2: Tactical concept &amp; target objective" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                                        <TextBlock Text="• Level 3: Specific piece to move" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                                        <TextBlock Text="• Level 4: Full tactical move &amp; variation" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <Button Content="Next Hint Level"
                                            Command="{Binding RequestNextHintAsyncCommand}"
                                            IsEnabled="{Binding CanRequestNextHint}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="14,10"
                                            Margin="0,0,4,0" />

                                    <Button Content="Reset Hints"
                                            Command="{Binding ResetHintsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="14,10"
                                            Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- TAB 4: INTERACTIVE Q&A                          -->
                    <!-- ================================================ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="QandA">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Quick chips -->
                                <RowDefinition Height="Auto" />
                                <!-- Chat history -->
                                <RowDefinition Height="*" />
                                <!-- Question Input -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Quick Suggestion Buttons -->
                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Content="What is my plan?"
                                        Command="{Binding AskQuickQuestionAsyncCommand}"
                                        CommandParameter="What is my best strategic plan in this position?"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,6,6" />

                                <Button Content="Is my king safe?"
                                        Command="{Binding AskQuickQuestionAsyncCommand}"
                                        CommandParameter="Is my king safe and what threats does my opponent have?"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,6,6" />

                                <Button Content="Unprotected pieces?"
                                        Command="{Binding AskQuickQuestionAsyncCommand}"
                                        CommandParameter="Are any of my pieces unprotected or vulnerable to tactical shots?"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,6,6" />

                                <Button Content="Should I trade?"
                                        Command="{Binding AskQuickQuestionAsyncCommand}"
                                        CommandParameter="Should I trade pieces or maintain tension on the board?"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Margin="0,0,6,6" />
                            </WrapPanel>

                            <!-- Conversation History -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,4,0,8"
                                                        Padding="12,10"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#252A36" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCoach}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Sender}"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AccentLightBrush}" />
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Right" />
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding Text}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap" />

                                                        <!-- Engine Footnote for Anti-Hallucination verification -->
                                                        <Border Margin="0,6,0,0"
                                                                Padding="6,2"
                                                                Background="#15000000"
                                                                CornerRadius="4"
                                                                Visibility="{Binding EngineEvidence, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding EngineEvidence}"
                                                                       FontSize="10"
                                                                       FontStyle="Italic"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Question Input Bar -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding QuestionInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="10,8"
                                         FontSize="12"
                                         Margin="0,0,8,0" />

                                <Button Grid.Column="1"
                                        Content="Ask"
                                        Command="{Binding SendQuestionAsyncCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,8" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- TAB 5: GAME REVIEW                              -->
                    <!-- ================================================ -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="GameReview">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Accuracy Scores Card -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="MATCH ACCURACY SCORES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="WHITE ACCURACY" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding WhiteAccuracy, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="BLACK ACCURACY" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding BlackAccuracy, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Game Narrative Summary -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GRANDMASTER SUMMARY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding GameReviewSummary}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Turning Points Header & List -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CRITICAL TURNING POINTS (CLICK TO JUMP)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding TurningPoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectTurningPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Margin="0,2,0,4"
                                                            Padding="10,6"
                                                            Style="{StaticResource SecondaryButtonStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding MoveNumber, StringFormat='M{0}:'}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentLightBrush}"
                                                                       Margin="0,0,8,0" />

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Explanation}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding PlayedMoveSan}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Recommended Lessons & Puzzles Based on Weaknesses -->
                                <Border Background="{StaticResource BackgroundDarkBrush}"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="RECOMMENDED LESSONS &amp; PUZZLES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8" />

                                        <!-- Lessons -->
                                        <ItemsControl ItemsSource="{Binding RecommendedLessons}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2,0,6" Padding="10,6" Background="#20FFFFFF" CornerRadius="6">
                                                        <DockPanel>
                                                            <Button Content="Open Lesson"
                                                                    Command="{Binding DataContext.JumpToLessonAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="8,3"
                                                                    FontSize="10"
                                                                    DockPanel.Dock="Right" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Stage, StringFormat='Stage: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Puzzles -->
                                        <ItemsControl ItemsSource="{Binding RecommendedPuzzles}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2,0,6" Padding="10,6" Background="{StaticResource AccentSubtleBrush}" CornerRadius="6">
                                                        <DockPanel>
                                                            <Button Content="Solve Puzzle"
                                                                    Command="{Binding DataContext.JumpToPuzzleAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Padding="8,3"
                                                                    FontSize="10"
                                                                    DockPanel.Dock="Right" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Theme, StringFormat='Tactical Puzzle: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentLightBrush}" />
                                                                <TextBlock Text="{Binding Rating, StringFormat='Rating: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Button Content="Review Current Game"
                                        Command="{Binding ReviewCurrentGameAsyncCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,10"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
