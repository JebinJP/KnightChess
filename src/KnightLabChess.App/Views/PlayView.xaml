<UserControl x:Class="KnightLabChess.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
             Loaded="PlayView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left Arena: Chess Board & Status Panels -->
        <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Game Status Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Turn & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Turn Indicator Circle -->
                        <Ellipse Width="16" Height="16" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FFF8F0" />
                                    <Setter Property="Stroke" Value="#FF3A3A3A" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Board.IsWhiteTurn}" Value="False">
                                            <Setter Property="Fill" Value="#FF1E1E1E" />
                                            <Setter Property="Stroke" Value="#FFE8E8E8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding Board.StatusText}"
                                   Style="{StaticResource H3TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Engine Thinking Indicator -->
                        <Border Background="#2010B981"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEngineThinking, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EngineThinkingText}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Claim Draw Button (Enabled only when claimable) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Claim Draw"
                                Command="{Binding ClaimDrawCommand}"
                                Visibility="{Binding Board.CanClaimDraw, Converter={StaticResource BoolToVis}}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Board Center Area -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Black Captured Tray (top) -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Board.CapturedBlackPieces}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Interactive Chessboard -->
                <controls:ChessBoardControl Grid.Row="1" DataContext="{Binding Board}" />

                <!-- White Captured Tray (bottom) -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding Board.CapturedWhitePieces}"
                              HorizontalAlignment="Center"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Notification Banner -->
            <Border Grid.Row="2"
                    Background="{StaticResource AccentDarkBrush}"
                    CornerRadius="6"
                    Padding="14,8"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding DismissNotificationCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Cursor="Hand"
                            FontWeight="Bold"
                            Padding="6,0" />
                    <TextBlock Text="{Binding NotificationMessage}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right Sidebar: Controls & Move History -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Game Actions Panel -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Match Configuration"
                               Style="{StaticResource H3TextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,10" />

                    <!-- Game Mode Selector -->
                    <TextBlock Text="MODE"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding GameModes}"
                              SelectedItem="{Binding SelectedMode}"
                              Padding="8,5"
                              Margin="0,0,0,10"
                              Background="{StaticResource BackgroundDarkBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}" />

                    <!-- Computer Options Panel (shown only when vs Computer) -->
                    <StackPanel Visibility="{Binding IsComputerMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,6">
                        <TextBlock Text="DIFFICULTY PRESET"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Difficulties}"
                                  SelectedItem="{Binding SelectedDifficulty}"
                                  Padding="8,5"
                                  Margin="0,0,0,10"
                                  Background="{StaticResource BackgroundDarkBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,10" />

                    <TextBlock Text="MATCH CONTROLS"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8" />

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="New Game"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartNewGameCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Undo Move"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UndoLastMoveCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Flip Board"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding FlipBoardCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Resign"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ResignCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,6,0,12" />

                    <!-- Persistence Buttons -->
                    <UniformGrid Columns="2">
                        <Button Content="💾 Save Game"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveActiveGameCommand}"
                                Margin="0,0,4,0"
                                ToolTip="Persist current match and move journal to SQLite" />
                        <Button Content="📂 Load Last"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadLastSavedGameCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Load most recent saved game and continue playing" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Move History Panel -->
            <controls:MoveLogPanel Grid.Row="1" DataContext="{Binding Board}" />
        </Grid>
    </Grid>
</UserControl>
