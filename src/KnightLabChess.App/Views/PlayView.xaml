<UserControl x:Class="KnightLabChess.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KnightLabChess.App.Controls"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
             Loaded="PlayView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left Area: Board & Player Status -->
            <ColumnDefinition Width="*" />
            <!-- Right Area: Match Configuration & Move History -->
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Left Arena: Chess Board & Status Panels -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Game Status / Turn Header Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Top Player Profile & Captured Pieces Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Chess Board Viewbox (Square, Centered, Perfectly Stable) -->
                <RowDefinition Height="*" />
                <!-- Row 3: Bottom Player Profile & Captured Pieces Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 4: Notification Banner -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Game Status Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Turn & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Turn Indicator Circle -->
                        <Ellipse Width="16" Height="16" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FFF8F0" />
                                    <Setter Property="Stroke" Value="#FF3A3A3A" />
                                    <Setter Property="StrokeThickness" Value="1.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Board.IsWhiteTurn}" Value="False">
                                            <Setter Property="Fill" Value="#FF1E1E1E" />
                                            <Setter Property="Stroke" Value="#FFE8E8E8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding Board.StatusText}"
                                   Style="{StaticResource H3TextStyle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Engine Thinking Indicator -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEngineThinking, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EngineThinkingText}"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Claim Draw Button (Enabled only when claimable) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Claim Draw"
                                Command="{Binding ClaimDrawCommand}"
                                Visibility="{Binding Board.CanClaimDraw, Converter={StaticResource BoolToVis}}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top Player Bar (Above the board, outside Viewbox) -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6"
                    Margin="0,0,0,8"
                    Height="42">
                <DockPanel LastChildFill="True">
                    <!-- Left: Player Info -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6"
                                Width="28" Height="28"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding TopPlayerIcon}"
                                       FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TopPlayerName}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding TopPlayerSubtext}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Active Turn Indicator -->
                        <Border Background="{StaticResource AccentBrush}"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsTopPlayerActiveTurn, Converter={StaticResource BoolToVis}}"
                                ToolTip="To move" />
                    </StackPanel>

                    <!-- Right: Captured pieces & material score -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ItemsControl ItemsSource="{Binding Board.TopCapturedPieces}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="1,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource SurfaceHoverBrush}"
                                CornerRadius="4"
                                Padding="5,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Board.TopMaterialAdvantage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Board.TopMaterialAdvantage}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Board Center Area: Maximized responsive square chess board -->
            <Grid Grid.Row="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <controls:ChessBoardControl DataContext="{Binding Board}" />
            </Grid>

            <!-- Bottom Player Bar (Below the board, outside Viewbox) -->
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6"
                    Margin="0,8,0,0"
                    Height="42">
                <DockPanel LastChildFill="True">
                    <!-- Left: Player Info -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6"
                                Width="28" Height="28"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding BottomPlayerIcon}"
                                       FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BottomPlayerName}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding BottomPlayerSubtext}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <!-- Active Turn Indicator -->
                        <Border Background="{StaticResource AccentBrush}"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBottomPlayerActiveTurn, Converter={StaticResource BoolToVis}}"
                                ToolTip="To move" />
                    </StackPanel>

                    <!-- Right: Captured pieces & material score -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ItemsControl ItemsSource="{Binding Board.BottomCapturedPieces}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="1,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource SurfaceHoverBrush}"
                                CornerRadius="4"
                                Padding="5,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Board.BottomMaterialAdvantage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Board.BottomMaterialAdvantage}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 4: Coach Feedback & Notification Banners -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <!-- AI Coach Thinking Progress Banner -->
                <Border Background="{StaticResource SurfaceGlassBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,6"
                        Visibility="{Binding IsCoachAnalyzing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CoachStatusText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- AI Coach Feedback Card -->
                <Border Background="{StaticResource SurfaceGlassBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,6"
                        Visibility="{Binding HasCoachFeedback, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#C89B3C" Opacity="0.25" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Command="{Binding DismissCoachFeedbackCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Cursor="Hand"
                                    Padding="4,0" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding LatestCoachFeedback.Title}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding LatestCoachFeedback.Summary}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,2" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding LatestCoachFeedback.TacticalExplanation}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Notification Banner -->
                <Border Background="{StaticResource AccentDarkBrush}"
                        CornerRadius="6"
                        Padding="14,8"
                        Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Command="{Binding DismissNotificationCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Cursor="Hand"
                                FontWeight="Bold"
                                Padding="6,0" />
                        <TextBlock Text="{Binding NotificationMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Right Sidebar: Controls & Move History -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Match Configuration & Actions Panel -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Match Configuration"
                               Style="{StaticResource H3TextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <!-- Game Mode Label -->
                    <TextBlock Text="GAME MODE"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <!-- Modern Game Mode Selection Cards -->
                    <!-- Card 1: Pass & Play -->
                    <Button Style="{x:Null}"
                            Command="{Binding SetPassAndPlayModeCommand}"
                            Cursor="Hand"
                            Margin="0,0,0,6"
                            BorderThickness="0"
                            Padding="0"
                            Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="modeCard"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHumanVsHuman}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="6"
                                                Width="32" Height="32"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Pass &amp; Play"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Play locally with a friend on this device"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Selected checkmark badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="10"
                                                Width="20" Height="20"
                                                Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsHumanVsHuman, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Card 2: Play Computer -->
                    <Button Style="{x:Null}"
                            Command="{Binding SetComputerModeCommand}"
                            Cursor="Hand"
                            Margin="0,0,0,10"
                            BorderThickness="0"
                            Padding="0"
                            Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="modeCard"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHumanVsComputer}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="6"
                                                Width="32" Height="32"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Play Computer"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Challenge the built-in Stockfish engine"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Selected checkmark badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="10"
                                                Width="20" Height="20"
                                                Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsHumanVsComputer, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Computer Options Panel (shown only when vs Computer) -->
                    <StackPanel Visibility="{Binding IsComputerMode, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,10">
                        <!-- Play As Color Selector -->
                        <TextBlock Text="PLAY AS"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6" />

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <!-- Play as White -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetWhiteColorCommand}"
                                    Cursor="Hand"
                                    Margin="0,0,4,0"
                                    BorderThickness="0"
                                    Padding="0"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="8,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHumanWhite}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="♔" FontSize="18" Foreground="#FFF8F0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="White" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Play as Black -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetBlackColorCommand}"
                                    Cursor="Hand"
                                    Margin="4,0,0,0"
                                    BorderThickness="0"
                                    Padding="0"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="8,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHumanBlack}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="♚" FontSize="18" Foreground="#FFCCCCCC" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Black" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>

                        <!-- Difficulty Preset Selector -->
                        <TextBlock Text="DIFFICULTY PRESET"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,6" />

                        <UniformGrid Columns="4" Margin="0,0,0,6">
                            <!-- Casual -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetCasualDifficultyCommand}"
                                    Cursor="Hand"
                                    Margin="0,0,2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="4,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCasualDifficulty}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Casual" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="1000" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Intermediate -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetIntermediateDifficultyCommand}"
                                    Cursor="Hand"
                                    Margin="2,0,2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="4,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIntermediateDifficulty}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Interm." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="1400" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Advanced -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetAdvancedDifficultyCommand}"
                                    Cursor="Hand"
                                    Margin="2,0,2,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="4,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdvancedDifficulty}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Adv." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="1800" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Master -->
                            <Button Style="{x:Null}"
                                    Command="{Binding SetMasterDifficultyCommand}"
                                    Cursor="Hand"
                                    Margin="2,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Padding="4,8" BorderThickness="1.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMasterDifficulty}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Master" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="2400+" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,10" />

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="{Binding AskCoachButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RequestCoachAdviceCommand}"
                                Margin="0,0,4,0"
                                ToolTip="Receive pedagogical advice grounded in verified engine analysis" />
                        <Button Content="✦ Open AI Coach"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenInAiCoachAsyncCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Transfer game position to dedicated AI Coach workstation" />
                    </UniformGrid>

                    <TextBlock Text="MATCH CONTROLS"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,8" />

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="New Game"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartNewGameCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Undo Move"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding UndoLastMoveCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Flip Board"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding FlipBoardCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="Resign"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ResignCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,10" />

                    <!-- Persistence Buttons -->
                    <UniformGrid Columns="2">
                        <Button Content="💾 Save Game"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveActiveGameCommand}"
                                Margin="0,0,4,0"
                                ToolTip="Persist current match and move journal to SQLite" />
                        <Button Content="📂 Load Last"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadLastSavedGameCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Load most recent saved game and continue playing" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Move History Panel -->
            <controls:MoveLogPanel Grid.Row="1" DataContext="{Binding Board}" />
        </Grid>
    </Grid>
</UserControl>
