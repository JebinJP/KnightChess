<UserControl x:Class="KnightLabChess.App.Controls.ChessBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
             x:Name="RootBoardControl">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <!-- 8x8 Board Squares -->
            <ItemsControl ItemsSource="{Binding Squares}"
                          Width="520" Height="520"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardSquareViewModel}">
                        <Button Style="{x:Null}"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0"
                                Cursor="Hand"
                                Command="{Binding DataContext.SelectSquareCommand, ElementName=RootBoardControl}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Square Background -->
                                        <Border>
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource SquareBackgroundConverter}">
                                                    <Binding Path="IsLightSquare" />
                                                    <Binding Path="IsSelected" />
                                                    <Binding Path="IsLastMoveFrom" />
                                                    <Binding Path="IsLastMoveTo" />
                                                    <Binding Path="IsCheck" />
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>

                                        <!-- Board Coordinates: Rank (top-left) -->
                                        <TextBlock Text="{Binding RankLabel}"
                                                   Visibility="{Binding HasRankLabel, Converter={StaticResource BoolToVis}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{Binding IsLightSquare, Converter={StaticResource BoardCoordinateBrushConverter}}"
                                                   Margin="3,2,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False" />

                                        <!-- Board Coordinates: File (bottom-right) -->
                                        <TextBlock Text="{Binding FileLabel}"
                                                   Visibility="{Binding HasFileLabel, Converter={StaticResource BoolToVis}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{Binding IsLightSquare, Converter={StaticResource BoardCoordinateBrushConverter}}"
                                                   Margin="0,0,3,1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False" />

                                        <!-- Quiet Legal Move Indicator (Center translucent dot) -->
                                        <Ellipse Width="18" Height="18"
                                                 Fill="#38000000"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Capture Legal Move Target Ring (Refined concentric circular frame) -->
                                        <Ellipse Width="54" Height="54"
                                                 Stroke="#45000000"
                                                 StrokeThickness="5"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Piece Representation (High Quality Vector DrawingImage) -->
                                        <Image Source="{Binding PieceKey, Converter={StaticResource DrawingKeyConverter}}"
                                               Stretch="Uniform"
                                               Margin="4"
                                               Visibility="{Binding HasPiece, Converter={StaticResource BoolToVis}}"
                                               IsHitTestVisible="False"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Selected Square Highlight Border -->
                                        <Border BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
