<UserControl x:Class="KnightLabChess.App.Controls.ChessBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
             x:Name="RootBoardControl">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <!-- 8x8 Board Squares -->
            <ItemsControl ItemsSource="{Binding Squares}"
                          Width="520" Height="520"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardSquareViewModel}">
                        <Button Style="{x:Null}"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0"
                                Cursor="Hand"
                                Command="{Binding DataContext.SelectSquareCommand, ElementName=RootBoardControl}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Square Background -->
                                        <Border>
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource SquareBackgroundConverter}">
                                                    <Binding Path="IsLightSquare" />
                                                    <Binding Path="IsSelected" />
                                                    <Binding Path="IsLastMoveFrom" />
                                                    <Binding Path="IsLastMoveTo" />
                                                    <Binding Path="IsCheck" />
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>

                                        <!-- Piece Representation -->
                                        <Viewbox Margin="5"
                                                 Visibility="{Binding HasPiece, Converter={StaticResource BoolToVis}}"
                                                 IsHitTestVisible="False">
                                            <Path Data="{Binding PieceKey, Converter={StaticResource GeometryKeyConverter}}"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#FFF8F0" />
                                                        <Setter Property="Stroke" Value="#FF1E1E1E" />
                                                        <Setter Property="StrokeThickness" Value="1.4" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWhitePiece}" Value="False">
                                                                <Setter Property="Fill" Value="#FF222222" />
                                                                <Setter Property="Stroke" Value="#FFE8E8E8" />
                                                                <Setter Property="StrokeThickness" Value="1.4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Viewbox>

                                        <!-- Quiet Legal Move Indicator (Center translucent circle) -->
                                        <Ellipse Width="16" Height="16"
                                                 Fill="#40000000"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Capture Legal Move Indicator (Corner brackets / ring around enemy piece) -->
                                        <Border BorderBrush="#90E53935"
                                                BorderThickness="3"
                                                CornerRadius="6"
                                                Margin="2"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Selected Square Border -->
                                        <Border BorderBrush="#FFFDD835"
                                                BorderThickness="2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
