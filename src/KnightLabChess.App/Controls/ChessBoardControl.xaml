<UserControl x:Class="KnightLabChess.App.Controls.ChessBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnightLabChess.App.ViewModels"
             x:Name="RootBoardControl">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceGlassBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.45" />
        </Border.Effect>

        <Grid x:Name="BoardContainerGrid"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Transparent"
              Focusable="True"
              PreviewMouseLeftButtonDown="Board_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Board_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Board_PreviewMouseLeftButtonUp"
              PreviewMouseRightButtonDown="Board_PreviewMouseRightButtonDown"
              LostMouseCapture="Board_LostMouseCapture"
              PreviewKeyDown="Board_PreviewKeyDown">

            <!-- 8x8 Board Squares -->
            <ItemsControl x:Name="SquaresItemsControl"
                          ItemsSource="{Binding Squares}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardSquareViewModel}">
                        <Button Style="{x:Null}"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0"
                                Cursor="Hand"
                                Command="{Binding DataContext.SelectSquareCommand, ElementName=RootBoardControl}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Square Background -->
                                        <Border>
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource SquareBackgroundConverter}">
                                                    <Binding Path="IsLightSquare" />
                                                    <Binding Path="IsSelected" />
                                                    <Binding Path="IsLastMoveFrom" />
                                                    <Binding Path="IsLastMoveTo" />
                                                    <Binding Path="IsCheck" />
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>

                                        <!-- Board Coordinates: Rank (top-left) -->
                                        <TextBlock Text="{Binding RankLabel}"
                                                   Visibility="{Binding HasRankLabel, Converter={StaticResource BoolToVis}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{Binding IsLightSquare, Converter={StaticResource BoardCoordinateBrushConverter}}"
                                                   Margin="4,2,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False" />

                                        <!-- Board Coordinates: File (bottom-right) -->
                                        <TextBlock Text="{Binding FileLabel}"
                                                   Visibility="{Binding HasFileLabel, Converter={StaticResource BoolToVis}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{Binding IsLightSquare, Converter={StaticResource BoardCoordinateBrushConverter}}"
                                                   Margin="0,0,4,2"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False" />

                                        <!-- Quiet Legal Move Indicator (Center translucent dot) -->
                                        <Ellipse Width="18" Height="18"
                                                 Fill="#45000000"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Capture Legal Move Target Ring (Responsive concentric circular frame) -->
                                        <Border CornerRadius="999"
                                                Margin="6"
                                                BorderBrush="#50000000"
                                                BorderThickness="4.5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLegalMove}" Value="True" />
                                                                <Condition Binding="{Binding HasPiece}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Piece Representation (High Quality Vector DrawingImage) -->
                                        <Image Source="{Binding PieceKey, Converter={StaticResource DrawingKeyConverter}}"
                                               Stretch="Uniform"
                                               Margin="4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasPiece, Converter={StaticResource BoolToVis}}"
                                               IsHitTestVisible="False"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
                                                            <Setter Property="Opacity" Value="0.2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBeingAnimated}" Value="True">
                                                            <Setter Property="Opacity" Value="0.0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Selected Square Highlight Border -->
                                        <Border BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="2.5"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Overlay Canvas for Dragging, Smooth Piece Movement, and Capture Polish -->
            <Canvas x:Name="OverlayCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    ClipToBounds="False">
                <!-- Subtle Capture Ripple Ring -->
                <Border x:Name="CaptureRippleRing"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3"
                        CornerRadius="999"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />

                <!-- Primary Moving Animated Piece -->
                <Image x:Name="AnimatedPiece"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.5" />
                    </Image.Effect>
                </Image>

                <!-- Secondary Castling Rook Animated Piece -->
                <Image x:Name="AnimatedPiece2"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.5" />
                    </Image.Effect>
                </Image>

                <!-- Drag Adorner / Floating Piece Overlay -->
                <Image x:Name="GhostPiece"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="6" Color="#000000" Opacity="0.6" />
                    </Image.Effect>
                </Image>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
